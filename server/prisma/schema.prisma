generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. TENANCY & LIGAS
// ============================================================================

model League {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(100)
  city            String   @db.VarChar(100)
  state           String   @db.VarChar(2)
  instagramHandle String?  @map("instagram_handle") @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rankingRule RankingRule?
  editions    Edition[]
  homeMcs     MC[]
  stats       LeagueMcStats[]

  @@map("leagues")
}

model RankingRule {
  id                    String   @id @default(uuid()) @db.Uuid
  leagueId              String   @unique @map("league_id") @db.Uuid
  pointsChampion        Int      @default(10) @map("points_champion")
  pointsRunnerUp        Int      @default(6) @map("points_runner_up")
  pointsSemifinalist    Int      @default(3) @map("points_semifinalist")
  pointsQuarterfinalist Int      @default(1) @map("points_quarterfinalist")
  pointsParticipation   Int      @default(1) @map("points_participation")
  pointsTwolalaBonus    Int      @default(0) @map("points_twolala_bonus")
  pointsWinPerMatch     Int      @default(1) @map("points_win_per_match")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("ranking_rules")
}

// ============================================================================
// 2. ATORES (MCs)
// ============================================================================

model MC {
  id           String   @id @default(uuid()) @db.Uuid
  vulgo        String   @db.VarChar(50)
  realName     String?  @map("real_name") @db.VarChar(100)
  instagram    String?  @db.VarChar(50)
  homeLeagueId String?  @map("home_league_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  homeLeague        League?            @relation(fields: [homeLeagueId], references: [id], onDelete: SetNull)
  competitorMembers CompetitorMember[]
  leagueStats       LeagueMcStats[]

  @@index([vulgo])
  @@map("mcs")
}

// ============================================================================
// 3. EDITIONS (O Evento)
// ============================================================================

enum EditionFormat {
  SOLO
  DUPLA
  TRIO
  QUARTETO
}

enum EditionStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Edition {
  id            String        @id @default(uuid()) @db.Uuid
  leagueId      String        @map("league_id") @db.Uuid
  editionNumber Int           @map("edition_number")
  editionDate   DateTime      @default(now()) @map("edition_date") @db.Date
  format        EditionFormat @default(SOLO)
  bracketSize   Int           @map("bracket_size") // 8 ou 16
  status        EditionStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  league      League       @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  competitors Competitor[]
  matches     Match[]

  @@unique([leagueId, editionNumber])
  @@map("editions")
}

// ============================================================================
// 4. COMPETITORS (Vagas/Times da Noite)
// ============================================================================

model Competitor {
  id         String   @id @default(uuid()) @db.Uuid
  editionId  String   @map("edition_id") @db.Uuid
  seedNumber Int?     @map("seed_number") // Número da plateia (1..8 ou 1..16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  edition Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  members CompetitorMember[]

  matchesAsA Match[] @relation("CompetitorA")
  matchesAsB Match[] @relation("CompetitorB")
  matchesWon Match[] @relation("WinnerCompetitor")

  @@map("competitors")
}

model CompetitorMember {
  competitorId String @map("competitor_id") @db.Uuid
  mcId         String @map("mc_id") @db.Uuid

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  mc         MC         @relation(fields: [mcId], references: [id], onDelete: Restrict)

  @@id([competitorId, mcId])
  @@map("competitor_members")
}

// ============================================================================
// 5. MATCHES (A Árvore de Confrontos / Bracket)
// ============================================================================

enum MatchPhase {
  PRE_PHASE
  ROUND_OF_16
  QUARTERS
  SEMIS
  FINAL
}

enum MatchResultType {
  TWOLALA // 2x0 direto sem réplica
  REPLICA // 2x1 / vitória no 3º round
  WO
}

model Match {
  id           String     @id @default(uuid()) @db.Uuid
  editionId    String     @map("edition_id") @db.Uuid
  phase        MatchPhase
  orderInPhase Int        @map("order_in_phase")

  competitorAId String? @map("competitor_a_id") @db.Uuid
  competitorBId String? @map("competitor_b_id") @db.Uuid

  winnerCompetitorId String?          @map("winner_competitor_id") @db.Uuid
  resultType         MatchResultType? @map("result_type")

  // Grafo da Chave
  nextMatchId   String?  @map("next_match_id") @db.Uuid
  nextMatchSlot String?  @map("next_match_slot") @db.VarChar(1) // 'A' ou 'B'
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  edition          Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  competitorA      Competitor? @relation("CompetitorA", fields: [competitorAId], references: [id], onDelete: SetNull)
  competitorB      Competitor? @relation("CompetitorB", fields: [competitorBId], references: [id], onDelete: SetNull)
  winnerCompetitor Competitor? @relation("WinnerCompetitor", fields: [winnerCompetitorId], references: [id], onDelete: SetNull)
  nextMatch        Match?      @relation("MatchTree", fields: [nextMatchId], references: [id], onDelete: SetNull)
  previousMatches  Match[]     @relation("MatchTree")

  @@map("matches")
}

// ============================================================================
// 6. READ-MODEL (Estatísticas e Ranking)
// ============================================================================

model LeagueMcStats {
  leagueId       String   @map("league_id") @db.Uuid
  mcId           String   @map("mc_id") @db.Uuid
  totalPoints    Int      @default(0) @map("total_points")
  matchesWon     Int      @default(0) @map("matches_won")
  matchesLost    Int      @default(0) @map("matches_lost")
  twolalasGiven  Int      @default(0) @map("twolalas_given")
  titlesCount    Int      @default(0) @map("titles_count")
  runnersUpCount Int      @default(0) @map("runners_up_count")
  editionsCount  Int      @default(0) @map("editions_count")
  lastUpdatedAt  DateTime @default(now()) @updatedAt @map("last_updated_at") @db.Timestamptz

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  mc     MC     @relation(fields: [mcId], references: [id], onDelete: Cascade)

  @@id([leagueId, mcId])
  @@index([leagueId, totalPoints(sort: Desc)])
  @@map("league_mc_stats")
}